# Environment files — never commit real secrets
.env
.env.*
!.env.example
!backend/.env.example

# Go
backend/wms-server
backend/wms-worker
backend/*.exe
backend/*.test
backend/*.out

# Swagger generated output stays reproducible via `swag init`, not committed
backend/docs/docs.go
backend/docs/swagger.json
backend/docs/swagger.yaml

# Frontend build/dependency artifacts (frontend itself IS tracked in this monorepo)
fontend/node_modules/
fontend/dist/
fontend/.vite/

# Database backup — large binary, must never be committed
wms.bak

# Demo Data Generator run output (backend/cmd/demodata) — generated
# passwords and run manifests, never real customer data but never
# meant to be committed either; docs/demo-data/EWTA/ holds EWTA's real
# customer onboarding files and is NOT covered by this rule.
docs/demo-data/*credentials*
docs/demo-data/*manifest*.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local tool state — not project source
.archify/
.claude/
