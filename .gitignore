# Environment files — never commit real secrets
.env
.env.*
!.env.example
!backend/.env.example

# Go
backend/wms-server
backend/wms-worker
backend/*.exe
backend/*.test
backend/*.out

# Swagger generated output stays reproducible via `swag init`, not committed
backend/docs/docs.go
backend/docs/swagger.json
backend/docs/swagger.yaml

# Frontend build/dependency artifacts (frontend itself IS tracked in this monorepo)
fontend/node_modules/
fontend/dist/
fontend/.vite/

# Database backup — large binary, must never be committed
wms.bak

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local tool state — not project source
.archify/
.claude/
