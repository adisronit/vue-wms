# Root environment file consumed by docker-compose.yml. Copy to ".env" in
# this same directory (Docker Compose loads .env automatically) and fill
# in real values before running `docker compose up`. Never commit the
# real .env file.

# ---- Application ----
APP_ENV=development
APP_PORT=8080
SWAGGER_ENABLED=true
JWT_SECRET=change-me-to-a-long-random-string
# Go duration string (e.g. "1h", "30m"). Falls back to 1h if unset/invalid.
JWT_EXPIRES_IN=1h
CORS_ALLOWED_ORIGINS=*
# Bounds a durable business mutation's SQL transaction (Receiving/
# Putaway confirm, inventory balance+ledger writes, role permission
# replace, ...) once it has been detached from the inbound HTTP
# request's own cancellable context — see internal/platform/dbctx. Go
# duration string. Falls back to 30s if unset/invalid.
DB_TRANSACTION_TIMEOUT=30s
# Hours a Stock Adjustment may sit PENDING before GET /stock-adjustments
# flags it is_overdue=true (follow-up visibility only — never auto-
# approves/rejects). Plain integer hours. Falls back to 48 if unset/invalid.
STOCK_ADJUSTMENT_PENDING_WARNING_HOURS=48
# Minutes between the server's scans for overdue PENDING adjustments to
# publish reminder jobs for (Phase 21). STOCK_ADJUSTMENT_PENDING_WARNING_HOURS
# above also doubles as the reminder cooldown — a still-unresolved
# adjustment is reminded again once it accumulates another full warning-
# hours period, not on every scan. Plain integer minutes. Falls back to
# 15 if unset/invalid.
STOCK_ADJUSTMENT_REMINDER_INTERVAL_MINUTES=15
# Server-side storage path for generated export files (Phase 22 —
# Report/Export), under the shared export_files Docker volume (mounted
# at this same path in both backend and worker). Falls back to
# /app/exports if unset/invalid.
EXPORT_DIR=/app/exports
# How long middleware.RequireTenantContext trusts a positive tenant
# membership check before re-querying the database (Phase 29B). Go
# duration string. Falls back to 60s if unset/invalid. A revoked/changed
# membership becomes visible within this window, not instantly — negative
# results are never cached regardless of this value.
TENANT_MEMBERSHIP_CACHE_TTL=60s

# ---- Phase 2 seed data (migrate service: `wms-migrate seed`) ----
# Used once to create the single development admin user. Both must be set
# for the admin user to be seeded; the password is bcrypt-hashed before
# storage and is never logged. Change these before any non-local use.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe_Adm1n!

# ---- SQL Server ----
# DB_USER must be "sa" unless the image is reconfigured for contained
# database users. DB_PASSWORD becomes the container's SA password and
# must satisfy SQL Server's complexity policy (8+ chars, upper, lower,
# digit, symbol) or the sqlserver container will fail to initialize.
DB_HOST=sqlserver
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=ChangeMe_Str0ng!
DB_NAME=wms
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# ---- RabbitMQ ----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=wms
RABBITMQ_PASSWORD=wms-password
RABBITMQ_VHOST=/

# ---- Frontend ----
# Consumed by the frontend build; the Vue app does not call any API yet
# in this phase, but the build-time value is wired now so later phases
# don't need a Docker/Nginx change to start using it.
VITE_API_BASE_URL=/api/v1

# ---- Host port mappings (development convenience only) ----
FRONTEND_PORT=80
BACKEND_PORT=8080
SQLSERVER_PORT=1433
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
