# Backend environment variables (API server + worker).
# Copy to backend/.env for standalone `go run` usage outside Docker.
# When running via docker compose, use the root-level .env.example instead —
# Compose injects these same variables into the backend/worker containers.

APP_ENV=development
APP_PORT=8080

# Inside Docker Compose this must be the service name "sqlserver", not
# localhost — localhost inside a container means that same container.
DB_HOST=sqlserver
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=ChangeMe_Str0ng!
DB_NAME=wms
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Used to sign/verify JWTs (POST /api/v1/auth/login, RequireJWT middleware).
JWT_SECRET=change-me-to-a-long-random-string
# Go duration string (e.g. "1h", "30m"). Falls back to 1h if unset/invalid.
JWT_EXPIRES_IN=1h

# Bounds a durable business mutation's SQL transaction (Receiving/
# Putaway confirm, inventory balance+ledger writes, role permission
# replace, ...) once it has been detached from the inbound HTTP
# request's own cancellable context — see internal/platform/dbctx. Go
# duration string. Falls back to 30s if unset/invalid.
DB_TRANSACTION_TIMEOUT=30s

# Hours a Stock Adjustment may sit PENDING before GET /stock-adjustments
# flags it is_overdue=true (Phase 20 — follow-up visibility only, never
# auto-approves/rejects). Plain integer hours. Falls back to 48 if
# unset/invalid.
STOCK_ADJUSTMENT_PENDING_WARNING_HOURS=48

# Minutes between the server's scans for overdue PENDING adjustments to
# publish reminder jobs for (Phase 21 — RabbitMQ queue
# wms.stock_adjustment.pending_reminder, consumed by the worker into a
# notification per stock_adjustment.approve holder).
# STOCK_ADJUSTMENT_PENDING_WARNING_HOURS above also doubles as the
# reminder cooldown — no separate cooldown knob. Plain integer minutes.
# Falls back to 15 if unset/invalid.
STOCK_ADJUSTMENT_REMINDER_INTERVAL_MINUTES=15

# Server-side storage path for generated export files (Phase 22 —
# Report/Export's async pipeline). In Docker this must be the same path
# the export_files volume is mounted at in both backend and worker
# containers. Falls back to /app/exports if unset. For a local `go run`
# outside Docker, point this at a real local directory instead (e.g.
# ./exports) — there is no shared volume in that case, so the same
# process must both write and serve the files, or point both binaries
# at literally the same filesystem path.
EXPORT_DIR=/app/exports

# Used once by `go run ./cmd/migrate seed` to create the development admin
# user. Both must be set for the admin user to be seeded; the password is
# bcrypt-hashed before storage and never logged.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe_Adm1n!

# Inside Docker Compose this must be the service name "rabbitmq", not
# localhost.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=wms
RABBITMQ_PASSWORD=wms-password
RABBITMQ_VHOST=/

SWAGGER_ENABLED=true

# Optional. Comma-separated list of allowed origins for local `vite dev`
# usage against this backend. Leave unset or "*" in development.
CORS_ALLOWED_ORIGINS=*
